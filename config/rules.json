{
  "_comment": "Feluda rule configuration. All detection signals are heuristics: an 'unusual' port or a flag from this file is a SIGNAL, never proof of malice. Tune weights/thresholds here without touching code.",

  "well_known_ports": {
    "20": "FTP (data)",
    "21": "FTP (control)",
    "22": "SSH",
    "23": "Telnet",
    "25": "SMTP",
    "53": "DNS",
    "67": "DHCP",
    "68": "DHCP",
    "69": "TFTP",
    "80": "HTTP",
    "110": "POP3",
    "123": "NTP",
    "135": "MS RPC",
    "137": "NetBIOS",
    "138": "NetBIOS",
    "139": "NetBIOS (SMB)",
    "143": "IMAP",
    "161": "SNMP",
    "389": "LDAP",
    "443": "HTTPS",
    "445": "SMB",
    "465": "SMTPS",
    "514": "Syslog",
    "587": "SMTP (submission)",
    "636": "LDAPS",
    "993": "IMAPS",
    "995": "POP3S",
    "1433": "MS SQL Server",
    "1521": "Oracle DB",
    "3306": "MySQL",
    "3389": "RDP",
    "5432": "PostgreSQL",
    "5900": "VNC",
    "5985": "WinRM (HTTP)",
    "5986": "WinRM (HTTPS)",
    "6379": "Redis",
    "8080": "HTTP Proxy",
    "8443": "HTTPS Alt",
    "27017": "MongoDB"
  },

  "unusual_remote_ports": [4444, 5555, 6666, 6667, 1337, 31337, 12345, 9001],

  "suspicious_location_substrings": [
    "\\appdata\\local\\temp\\",
    "\\appdata\\roaming\\temp\\",
    "\\downloads\\",
    "\\users\\public\\",
    "\\temp\\"
  ],

  "normal_location_substrings": [
    "\\program files\\",
    "\\program files (x86)\\",
    "\\windows\\system32\\",
    "\\windows\\syswow64\\",
    "\\windows\\"
  ],

  "system_process_names": [
    "system",
    "system idle process",
    "registry",
    "smss.exe",
    "csrss.exe",
    "wininit.exe",
    "winlogon.exe",
    "services.exe",
    "lsass.exe",
    "lsm.exe",
    "svchost.exe",
    "spoolsv.exe",
    "dwm.exe",
    "explorer.exe",
    "sihost.exe",
    "taskhostw.exe",
    "ctfmon.exe",
    "fontdrvhost.exe",
    "dllhost.exe",
    "conhost.exe",
    "searchindexer.exe",
    "securityhealthservice.exe",
    "msmpeng.exe"
  ],

  "rule_weights": {
    "external_unknown_process": 30,
    "unusual_remote_port": 20,
    "suspicious_location": 25,
    "multiple_external_connections": 10,
    "repeated_connection": 10,
    "outside_baseline": 15
  },

  "thresholds": {
    "multiple_external_connections_min": 3,
    "repeated_connection_min_scans": 3,
    "hash_min_risk_score": 25,
    "alert_min_risk_score": 25
  },

  "risk_bands": {
    "LOW": [0, 24],
    "MEDIUM": [25, 49],
    "HIGH": [50, 74],
    "CRITICAL": [75, 100]
  },

  "monitor": {
    "poll_interval_seconds": 5
  },

  "export": {
    "directory": "exports"
  },

  "browser": {
    "_comment": "Browser & URL threat detection. known_browsers maps process-name -> (display name, engine, profile root under LOCALAPPDATA). All URL scoring signals are heuristics, never proof of malice.",
    "poll_interval_seconds": 10,
    "alert_min_risk_score": 60,
    "known_browsers": {
      "_comment": "name -> [display, engine, method, [candidate roots]]. method drives extract_tab dispatch (no per-browser forking in code). chromium roots resolve under %LOCALAPPDATA%; gecko/firefox roots resolve under %APPDATA% because that's where Mozilla puts its Profiles tree. First existing candidate root wins.",
      "chrome.exe": ["Chrome", "chromium", "chromium_history_fallback", ["Google\\Chrome\\User Data"]],
      "brave.exe":  ["Brave",  "chromium", "chromium_history_fallback", ["BraveSoftware\\Brave-Browser\\User Data"]],
      "msedge.exe": ["Edge",   "chromium", "chromium_history_fallback", ["Microsoft\\Edge\\User Data", "Packages\\Microsoft.MicrosoftEdge.Stable_8wekyb3d8bbwe\\LocalCache\\Local\\Microsoft\\Edge\\User Data"]],
      "arc.exe":    ["Arc",    "chromium", "chromium_history_fallback", ["Arc\\User Data", "Packages\\TheBrowserCompany.Arc_ttt1ap7aakyb4\\LocalCache\\Local\\Arc\\User Data"]],
      "firefox.exe":["Firefox","gecko",    "firefox_session",           ["Mozilla\\Firefox"]]
    },
    "max_history_rows_per_profile": 500
  },

  "url_risk": {
    "_comment": "Structural URL heuristics. Each rule returns (triggered, points, reason). Points are additive and capped at 100. Mixed-script uses real Unicode confusable classes; typosquat edit distance <= 2 against well-known brands is a common phishing pattern.",
    "suspicious_tlds": ["tk", "ml", "ga", "cf", "gq", "xyz", "top", "club", "work", "zip", "mov", "cam"],
    "typosquat_targets": [
      "google", "facebook", "youtube", "amazon", "microsoft", "apple",
      "netflix", "paypal", "instagram", "whatsapp", "linkedin", "github",
      "outlook", "office", "onedrive", "dropbox", "coinbase", "binance"
    ],
    "typosquat_shortener_allowlist": [
      "youtu.be", "t.co", "goo.gl", "bit.ly", "tinyurl.com", "buff.ly",
      "amzn.to", "fb.me", "lnkd.in", "ow.ly", "is.gd", "reut.rs"
    ],
    "length_outlier_threshold": 100,
    "percent_encoding_threshold": 6,
    "weights": {
      "homograph_idn": 35,
      "excessive_percent_encoding": 15,
      "ip_literal": 25,
      "suspicious_tld": 20,
      "typosquat": 30,
      "url_length_outlier": 10
    }
  },

  "vt": {
    "_comment": "VirusTotal public-API reputation checks. Free tier: 4 req/min, ~500 req/day. All lookups are opt-in via --reputation-check or FELUDA_VT_API_KEY, cached in SQLite, and never block the polling loop.",
    "base_url": "https://www.virustotal.com/api/v3",
    "rate_limit_per_minute": 4,
    "daily_quota": 500,
    "cache_ttl_days": 7,
    "cache_ttl_days_unknown": 1,
    "request_timeout_seconds": 10,
    "weights": {
      "vt_flagged_by_multiple_engines": 40,
      "vt_flagged_by_few_engines": 20,
      "vt_suspicious_only": 10,
      "vt_unknown": 0
    }
  },

  "cert": {
    "_comment": "Stage 3: TLS certificate inspection for https URLs. Fully offline-local after Stage 1; no API keys, no external quota. Values are additive and capped at 100 together with url_risk and vt weights. Self-signed/untrusted means no trusted root was presented.",
    "connect_timeout_seconds": 3,
    "cache_ttl_hours": 24,
    "cache_ttl_hours_unreachable": 1,
    "weights": {
      "cert_expired": 25,
      "cert_not_yet_valid": 20,
      "cert_self_signed_or_untrusted": 35,
      "cert_hostname_mismatch": 40,
      "cert_short_validity": 15,
      "cert_weak_signature": 10,
      "no_https": 5
    }
  },

  "geoip": {
    "_comment": "Stage 4: GeoIP + ASN enrichment. Default provider is ip-api.com (free, no key, HTTP-only free tier, NON-COMMERCIAL use only — see code comment in geoip_engine.py). MaxMind GeoLite2 is an optional fully-offline alternative: set provider='maxmind' plus the .mmdb paths yourself; never automated. Weights are intentionally modest — geography is weak evidence and should nudge, not dominate, a score.",
    "provider": "ip-api",
    "request_timeout_seconds": 4,
    "rate_limit_per_minute": 40,
    "cache_ttl_days": 30,
    "expected_countries": ["IN"],
    "high_risk_asns": ["as44477", "as9009", "as174", "bulletproof"],
    "cdn_org_keywords": ["cloudflare", "fastly", "akamai", "cloudfront", "amazon", "google", "microsoft", "edgecast", "bunnycdn", "stackpath", "imperva"],
    "datacenter_org_keywords": ["hosting", "datacenter", "server", "colo", "hetzner", "ovh", "digitalocean", "vultr", "linode", "contabo", "ionos"],
    "weights": {
      "unusual_country": 20,
      "high_risk_hosting_asn": 25,
      "datacenter_not_cdn": 10
    },
    "maxmind_city_mmdb": "",
    "maxmind_asn_mmdb": ""
  },

  "lineage": {
    "_comment": "Stage 5: process tree / parent-child lineage analysis. Runs locally via psutil — no external calls, no cache needed (point-in-time per scan). Rules:  office_spawned_shell, browser_spawned_suspicious_binary, unexpected_script_interpreter_parent, orphaned_or_reparented_process, unusual_chain_depth, cmdline_obfuscation_indicator. None of these alone is a verdict; additive contributions to the overall score.",
    "max_chain_depth": 6,
    "chain_depth_points": 10,
    "allowed_script_parents": ["explorer.exe", "cmd.exe", "taskhostw.exe", "svchost.exe", "conhost.exe", "taskmgr.exe", "code.exe", "notepad.exe", "devenv.exe"],
    "suspicious_location_keywords": ["\\appdata\\local\\temp\\", "\\downloads\\", "\\temp\\", "\\users\\public\\"],
    "shell_and_script_hosts": ["cmd.exe", "powershell.exe", "powershellise.exe", "wscript.exe", "cscript.exe", "mshta.exe", "wmic.exe", "conhost.exe"],
    "office_processes": ["winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe", "msaccess.exe", "mspub.exe", "visio.exe", "onenote.exe"],
    "weights": {
      "office_spawned_shell": 45,
      "browser_spawned_suspicious_binary": 35,
      "unexpected_script_interpreter_parent": 25,
      "orphaned_or_reparented_process": 20,
      "unusual_chain_depth": 10,
      "cmdline_obfuscation_indicator": 30
    }
  }
}
